# ── Runtime ──
NODE_ENV=development
PORT=3000
# Set to 1 only behind one known reverse proxy (Render blueprint does this).
# Leave unset for direct/self-hosted instances to prevent X-Forwarded-For spoofing.
# TRUST_PROXY=1

# ── OAuth Providers ──
# Google: https://console.cloud.google.com/apis/credentials
# Required scopes: openid email profile
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Discord: https://discord.com/developers/applications
# Required scopes: identify email
DISCORD_CLIENT_ID=your-discord-client-id
DISCORD_CLIENT_SECRET=your-discord-client-secret

# Apple (not yet implemented — reserved for future use)
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=

# Base URL for OAuth redirects (no trailing slash)
# In production: https://yourdomain.com (must be https)
OAUTH_REDIRECT_BASE=http://localhost:3000

# Public app URL, used for share links / CORS if different from OAUTH_REDIRECT_BASE
APP_URL=http://localhost:3000

# Comma-separated list of allowed CORS origins in production, e.g.:
# CORS_ORIGIN=https://sprite-index.app,https://www.sprite-index.app
CORS_ORIGIN=http://localhost:3000

# Optional comma-separated numeric user IDs allowed to read aggregate product
# analytics. Leave empty to keep these internal metrics unavailable to users.
ANALYTICS_ADMIN_USER_IDS=

# ── Terminal backoffice ──
# Legacy transition secret. Create named administrators from the backoffice,
# then rotate and ultimately remove this value. Never put plaintext here.
ADMIN_ACCESS_PASSWORD_HASH=
# Optional username passed by `npm run admin`; named accounts are stored in DB.
# ADMIN_OPERATOR_USERNAME=quentin
# Optional label written into admin_audit_log as "<label>:<sessionId>".
# ADMIN_OPERATOR_LABEL=ops-desk
# Least-privilege role for the terminal operator (default owner).
# Roles: owner | ops | moderator | editor | privacy | readonly
# ADMIN_OPERATOR_ROLE=owner
# Optional per-label map when several desks share the same deploy:
# ADMIN_OPERATOR_ROLES=ops-desk:owner,mod-desk:moderator,news-desk:editor
# TOTP MFA for /admin/access (generate with `npm run admin:totp`).
# When set, login requires MFA and privacy export/purge/restore/revoke need a fresh code (step-up).
# ADMIN_TOTP_SECRET=
# Fail closed if MFA is required but ADMIN_TOTP_SECRET is missing.
# ADMIN_REQUIRE_MFA=true
# Optional cap on simultaneous durable admin sessions (default 3).
# ADMIN_MAX_CONCURRENT_SESSIONS=3
# Soft-deleted accounts become purge-eligible after this many days (default 30).
# ACCOUNT_PURGE_RETENTION_DAYS=30
# Optional public origin used by `npm run admin` (defaults to APP_URL).
# ADMIN_CONSOLE_URL=https://yourdomain.com

# ── Database ──
# If set, overrides the local default Postgres connection (localhost:5432).
# Example: postgres://user:password@host:5432/sprite-index
# TLS with certificate verification is enabled automatically for every non-local
# host. `PGSSL=disable` is a development-only plaintext opt-out; never set it
# in production (the server refuses to start with it there).
DATABASE_URL=
# PGSSL=disable

# ── Resend (email verification + password reset) ──
# https://resend.com/api-keys
RESEND_API_KEY=re_XXXXXXXXX
FROM_EMAIL=SPRITE-INDEX <quentinsavigny@protonmail.com>

# ── Push notifications ──
# Web Push VAPID keys (generated automatically on first boot if not set).
# VAPID_SUBJECT=mailto:quentinsavigny@protonmail.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
#
# Android FCM legacy server key for native Capacitor pushes.
# FCM_SERVER_KEY=
#
# iOS APNS credentials (JWT-based) for native Capacitor pushes.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_KEY=-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----
# APNS_TOPIC=com.spriteindex.app

# ── Scraper (optional) ──
# Path to a Chrome/Chromium binary for the fortnite.gg news scraper.
# If unset/unavailable, news scraping is skipped (app still works fully).
# CHROME_PATH=/usr/bin/chromium
