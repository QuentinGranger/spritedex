{
  "name": "spritedex_app",
  "version": "1.0.0",
  "description": "Application web statique pour suivre les Sprites Fortnite et leurs variantes.",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.js",
    "seed": "node seed.js",
    "test:security": "node test/security.test.js",
    "test:compare": "node test/compare.test.js",
    "test:friends": "node test/friends.test.js",
    "test:squads": "node test/squads.test.js",
    "test:goals": "node test/goals.test.js",
    "test:suspension-sync": "node test/suspension-sync.test.js",
    "test:priority-availability": "node test/priority-availability.test.js",
    "test:event-ending": "node test/event-ending.test.js",
    "test:notification-load": "node test/notification-load.test.js",
    "test:notifications": "node test/notifications.test.js",
    "test:passport": "node test/passport.test.js && node test/passport-steps-81-85.test.js && node test/passport-steps-86-88.test.js",
    "test:sprite-graph": "node test/sprite-graph.test.js",
    "sprite-graph:status": "node scripts/sprite-graph-status.js",
    "test": "npm run test:notifications && npm run test:security && npm run test:compare && npm run test:friends && npm run test:squads && npm run test:goals && npm run test:suspension-sync && npm run test:priority-availability && npm run test:event-ending && npm run test:notification-load && npm run test:passport && npm run test:sprite-graph",
    "build:www": "node scripts/build-www.js",
    "cap:sync": "npm run build:www && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "desktop:dev": "npm run build:www && electron .",
    "desktop:dist": "npm run build:www && electron-builder",
    "desktop:mac": "npm run build:www && electron-builder --mac",
    "desktop:win": "npm run build:www && electron-builder --win",
    "desktop:linux": "npm run build:www && electron-builder --linux"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/status-bar": "^6.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "puppeteer-core": "^25.3.0",
    "qrcode": "^1.5.4",
    "resend": "^6.17.1",
    "web-push": "3.6",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.spritedex.desktop",
    "productName": "SPRITNEX",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "www/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
