{
  "name": "sprite-index",
  "version": "1.0.0",
  "description": "Application web statique pour suivre les Sprites Fortnite et leurs variantes.",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "node server.js",
    "worker": "node scripts/worker.js",
    "dev": "NODE_ENV=development APP_LIVE_RELOAD=1 node --watch server.js",
    "seed": "node seed.js",
    "migrate": "node scripts/migrate.js up",
    "migrate:status": "node scripts/migrate.js status",
    "migrate:rollback": "node scripts/migrate.js rollback",
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint src",
    "format": "prettier --write openapi.json eslint.config.js tsconfig.json test/api-contract.test.js test/a11y.test.js test/visual.test.js src",
    "format:check": "prettier --check openapi.json eslint.config.js tsconfig.json test/api-contract.test.js test/a11y.test.js test/visual.test.js src",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run test:api-contract",
    "test:security": "node test/security.test.js",
    "test:migrations": "node test/migrations.test.js",
    "test:schema-modules": "node test/schema-modules.test.js",
    "test:rate-limit": "node test/rate-limit-store.test.js",
    "test:architecture-foundations": "node test/architecture-foundations.test.js",
    "test:api-contract": "node test/api-contract.test.js",
    "test:a11y": "node test/a11y.test.js",
    "test:visual": "node test/visual.test.js",
    "test:i18n": "node test/i18n-modules.test.js",
    "test:i18n-en-export-modules": "node test/i18n-en-export-modules.test.js",
    "test:i18n-nl-message-modules": "node test/i18n-nl-message-modules.test.js",
    "test:index-html-modules": "node test/index-html-modules.test.js",
    "test:legal-content-modules": "node test/legal-content-modules.test.js",
    "test:catalog": "node test/catalog-loader.test.js",
    "test:import-catalog-modules": "node test/import-catalog-modules.test.js",
    "test:health": "node test/health.test.js",
    "test:compare": "node test/compare.test.js",
    "test:compare-client-modules": "node test/compare-client-modules.test.js",
    "test:compare-css-modules": "node test/compare-css-modules.test.js",
    "test:compare-modules": "node test/compare-modules.test.js",
    "test:friends": "node test/friends.test.js",
    "test:squads": "node test/squads.test.js",
    "test:squads-test-modules": "node test/squads-test-modules.test.js",
    "test:squad-modules": "node test/squad-route-modules.test.js",
    "test:squad-css-modules": "node test/squad-css-modules.test.js",
    "test:squad-engine-modules": "node test/squad-engine-modules.test.js",
    "test:render-squad-modules": "node test/render-squad-modules.test.js",
    "test:client-invites": "node test/client-invite-links.test.js",
    "test:client-metrics": "node test/client-collection-metrics.test.js",
    "test:collection-modules": "node test/collection-route-modules.test.js",
    "test:goals": "node test/goals.test.js",
    "test:goals-modules": "node test/goals-route-modules.test.js",
    "test:suspension-sync": "node test/suspension-sync.test.js",
    "test:priority-availability": "node test/priority-availability.test.js",
    "test:event-ending": "node test/event-ending.test.js",
    "test:events-modules": "node test/events-modules.test.js",
    "test:notification-load": "node test/notification-load.test.js",
    "test:notifications": "node test/notifications.test.js",
    "test:notification-modules": "node test/notification-modules.test.js",
    "test:push-service-modules": "node test/push-service-modules.test.js",
