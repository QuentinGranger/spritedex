    "test:sprite-graph-modules": "node test/sprite-graph-modules.test.js",
    "test:sprite-graph-service-modules": "node test/sprite-graph-service-modules.test.js",
    "test:sprite-graph-squad-stats-modules": "node test/sprite-graph-squad-stats-modules.test.js",
    "test:mastery": "node test/mastery.test.js",
    "test:mobile-swipe": "node test/mobile-swipe.e2e.test.js",
    "test:client-cache": "node test/client-cache.test.js",
    "test:admin": "node test/admin-access.test.js",
    "test:admin-html-modules": "node test/admin-html-modules.test.js",
    "test:backoffice": "node test/admin-backoffice.test.js",
    "test:admin-modules": "node test/admin-modules.test.js",
    "test:admin-operation-modules": "node test/admin-operations-modules.test.js",
    "test:account-css-modules": "node test/account-css-modules.test.js",
    "test:desktop-css-modules": "node test/desktop-css-modules.test.js",
    "test:shell-css-modules": "node test/shell-css-modules.test.js",
    "test:account-modules": "node test/account-modules.test.js",
    "admin:password": "node scripts/admin-password.js",
    "admin:totp": "node scripts/admin-totp.js",
    "admin": "node scripts/admin-open.js",
    "sprite-graph:status": "node scripts/sprite-graph-status.js",
    "test": "npm run test:migrations && npm run test:schema-modules && npm run test:rate-limit && npm run test:architecture-foundations && npm run test:i18n && npm run test:i18n-en-export-modules && npm run test:i18n-nl-message-modules && npm run test:index-html-modules && npm run test:legal-content-modules && npm run test:catalog && npm run test:import-catalog-modules && npm run test:sprite-graph-modules && npm run test:sprite-graph-service-modules && npm run test:sprite-graph-squad-stats-modules && npm run test:squad-modules && npm run test:squad-css-modules && npm run test:squad-engine-modules && npm run test:events-modules && npm run test:render-squad-modules && npm run test:notifications && npm run test:notification-modules && npm run test:push-service-modules && npm run test:health && npm run test:security && npm run test:compare-modules && npm run test:compare-client-modules && npm run test:compare-css-modules && npm run test:compare && npm run test:friends && npm run test:client-invites && npm run test:client-metrics && npm run test:collection-modules && npm run test:squads-test-modules && npm run test:squads && npm run test:goals-modules && npm run test:goals && npm run test:priority-availability && npm run test:notification-load && npm run test:passport-badge-modules && npm run test:passport-test-modules && npm run test:passport && npm run test:sprite-graph && npm run test:mastery && npm run test:admin && npm run test:mobile-swipe && npm run test:client-cache && npm run test:account-css-modules && npm run test:desktop-css-modules && npm run test:shell-css-modules && npm run test:account-modules && npm run test:admin-html-modules && npm run test:admin-modules && npm run test:admin-operation-modules && npm run test:backoffice",
    "build:www": "node scripts/build-www.js",
    "cap:sync": "npm run build:www && npx cap sync",
    "cap:ios": "npm run cap:sync && npx cap open ios",
    "cap:android": "npm run cap:sync && npx cap open android",
    "desktop:dev": "npm run build:www && electron .",
    "desktop:dist": "npm run build:www && electron-builder",
    "desktop:mac": "npm run build:www && electron-builder --mac",
    "desktop:win": "npm run build:www && electron-builder --win",
    "desktop:linux": "npm run build:www && electron-builder --linux"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/status-bar": "^6.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "puppeteer-core": "^25.3.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "resend": "^6.17.1",
    "web-push": "3.6",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@types/node": "^26.1.2",
    "axe-core": "^4.12.1",
    "electron": "^37.10.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "build": {
    "appId": "com.spriteindex.desktop",
    "productName": "SPRITE-INDEX",
    "icon": "desktop/logoImg/icon.png",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "www/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "desktop/logoImg/Favicon/favicon.ico",
      "target": "nsis"
    },
    "linux": {
      "icon": "desktop/logoImg/Favicon/android-chrome-512x512.png",
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
