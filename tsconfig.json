{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "src/**/*.js",
    "server/**/*.js",
    "scripts/**/*.js",
    "security.js",
    "security-logger.js",
    "server.js",
    "analytics.js",
    "push-service.js",
    "seed.js",
    "sprite-data.js"
  ],
  "exclude": ["node_modules", "www", "android", "ios", "release", "coverage"]
}
